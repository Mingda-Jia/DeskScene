<Window x:Class="DeskScene.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskScene" Icon="/icon.ico"
        SizeToContent="WidthAndHeight" MinWidth="380" MaxWidth="560"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Topmost="True">
  <StackPanel Margin="24,20">
    <TextBlock x:Name="Heading" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10" />
    <ContentPresenter x:Name="Body" />
    <TextBlock x:Name="Countdown" Style="{StaticResource Hint}" Margin="0,10,0,0" Visibility="Collapsed" />
    <StackPanel x:Name="Buttons" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0" />
  </StackPanel>
</Window>
